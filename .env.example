# PostgreSQL (локал: npm run db:up)
DATABASE_URL="postgresql://tsembii:tsembii@localhost:5433/tsembii"

# Зураг хадгалах хавтас. Railway дээр Volume-ийн зам (жишээ: /data/uploads)
UPLOAD_DIR="./uploads"

# Verify.mn-ийн API түлхүүр (2-р үе шат). Хоосон бол локал туршилтын горим, production дээр хориотой.
VERIFYMN_API_KEY=""

# Эхний бүрэн эрхтэй админ (npm run db:seed)
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME=""
